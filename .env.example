# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for signing authentication tokens (optional; falls back to runtime CSPRNG key).
SESSION_SECRET=

# ADMIN_EMAIL / ADMIN_PASSWORD: Optional overrides for the default academy administrator account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
